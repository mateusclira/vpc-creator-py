{
  "id": null,
  "uid": "vpc-view",
  "title": "VPC View",
  "tags": ["vpc", "aws"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Current VPCs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "current_vpcs",
          "legendFormat": "Current VPCs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "VPCs Created",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "vpcs_created_total",
          "legendFormat": "Created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "VPCs Deleted",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "vpcs_deleted_total",
          "legendFormat": "Deleted",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "VPC Activity (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Deleted" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Created" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "increase(vpcs_created_total[5m])",
          "legendFormat": "Created",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "increase(vpcs_deleted_total[5m])",
          "legendFormat": "Deleted",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "increase(aws_errors_total[5m])",
          "legendFormat": "AWS Errors",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "Application Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{service_name=\"vpc-creator-api\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Traces",
      "type": "traces",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 10 },
      "options": {
        "traceQuery": {
          "timeShiftEnabled": true,
          "spanStartTimeShift": "1h",
          "spanEndTimeShift": "-1h"
        },
        "spanBar": { "type": "duration" }
      },
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "Jaeger" },
          "service": "vpc-creator-api",
          "refId": "A"
        }
      ]
    }
  ]
}
